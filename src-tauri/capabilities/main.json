    "allow-repair-workspace-index",
    "allow-rebuild-workspace-conversations",
    "allow-reveal-eml",
    "allow-save-source-eml-as",
    "allow-save-standalone-source-message-as",
    "allow-save-printable-html-as",
    "allow-reveal-saved-html",
    "allow-reveal-saved-eml",
    "allow-export-attachment",
    "allow-open-attachment",
    "allow-export-standalone-message-attachment",
    "allow-open-standalone-message-attachment",
    "allow-reveal-exported-file-for-workspace",
    "allow-reveal-standalone-exported-file",
    "allow-reveal-import-log",
    "allow-reveal-original-pst-in-finder",
