{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Authority required by the trusted main application window.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-check-readpst",
    "allow-get-app-diagnostics",
    "allow-reveal-application-logs",
    "allow-reveal-project-license",
    "allow-reveal-third-party-notices",
    "allow-pick-pst-file",
    "allow-pick-message-file",
    "allow-plan-pst-open",
    "allow-open-pst",
    "allow-open-existing-workspace-from-session",
    "allow-activate-workspace",
    "allow-close-workspace",
    "allow-cancel-import",
    "allow-cancel-search-operation",
    "allow-list-folders",
    "allow-read-local-trash-summary",
    "allow-move-message-to-local-trash",
    "allow-restore-message-from-local-trash",
    "allow-undo-local-trash-operation",
    "allow-reset-local-trash-state",
    "allow-list-messages",
    "allow-count-messages",
    "allow-search-messages-multi",
    "allow-count-messages-multi",
    "allow-list-conversations",
    "allow-count-conversations",
    "allow-get-conversation-messages",
    "allow-get-message",
    "allow-get-message-diagnostics",
    "allow-render-message-html",
    "allow-get-source-eml-view",
