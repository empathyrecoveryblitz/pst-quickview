{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PST QuickView",
  "version": "0.2.0-beta.3",
  "identifier": "com.local.pstquickview",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PST QuickView",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["eml"],
        "name": "RFC 822 Email Message",
        "role": "Viewer",
        "rank": "Default",
        "contentTypes": ["public.email-message"],
        "mimeType": "message/rfc822"
      },
      {
        "ext": ["msg"],
        "name": "Microsoft Outlook Message",
        "role": "Viewer",
        "rank": "Default",
        "contentTypes": ["com.microsoft.outlook.msg"],
        "mimeType": "application/vnd.ms-outlook"
      },
      {
        "ext": ["pst"],
        "name": "Microsoft Outlook Personal Storage Table",
        "role": "Viewer",
        "rank": "Default",
        "contentTypes": ["com.microsoft.outlook.pst"]
      }
    ],
    "macOS": {
      "bundleVersion": "0.2.0.3",
      "hardenedRuntime": true,
      "infoPlist": "Info.plist"
    },
    "externalBin": [
      "binaries/readpst"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSES/GPL-3.0-or-later.txt": "LICENSES/GPL-3.0-or-later.txt",
      "../LICENSES/GPL-2.0-or-later.txt": "LICENSES/GPL-2.0-or-later.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
